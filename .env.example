# Copy to .env and adjust for docker compose.

POSTGRES_USER=podcast
POSTGRES_PASSWORD=podcast
POSTGRES_DB=podcast
POSTGRES_PORT=5432

PODCAST_PORT=8080
PODCAST_LOG_FORMAT=text
PODCAST_LOG_LEVEL=info

# Used when running the binary directly on the host (make run).
PODCAST_DATABASE__URL=postgres://podcast:podcast@localhost:5432/podcast?sslmode=disable
PODCAST_STORAGE__DIR=./data/blobs
